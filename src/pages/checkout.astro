---
/**
 * `/checkout` — THE ONE PAGE THAT SHIPS CLIENT JAVASCRIPT (R4-CHECKOUT,
 * 2026-08-18). Every other route keeps the zero-JS invariant; the gates
 * exempt exactly `dist/checkout.html` and say so where they do it.
 *
 * Honesty contract of this page:
 *   - the price shown comes from the founder-sealed config, never free text;
 *   - GST is stated BEFORE the pay button;
 *   - a dismissed modal is a normal outcome, not an error;
 *   - "payment received" is only ever said after /api/razorpay/subscription-status
 *     (which asks Razorpay itself) answers authenticated/active — the redirect
 *     alone proves nothing, and the webhook remains the server-side truth.
 *
 * Live release (BUSINESS-QUEUE B1, 2026-08-21): test-mode wording removed in
 * the same commit that allows live keys. Real money moves when live keys are
 * present and LIVE_PAYMENTS_RELEASED is true.
 */
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import { sealedPrice } from '../config/pricing';

const price = sealedPrice();
if (!price.publish) {
  throw new Error('R4: /checkout must not build without a founder-sealed price');
}
const rupees = price.inr.toLocaleString('en-IN');
---

<Base
  title="Checkout — AI Workspace"
  description="Warrant Guardian subscription checkout."
  canonicalPath="/checkout"
  indexableInProduction={false}
>
  <Container>
    <article class="checkout-page">
      <h1>Checkout</h1>
      <p>
        Warrant Guardian — <strong>₹{rupees} per month</strong>. GST as applicable is added at
        payment.
      </p>
      <p>
        You are buying a private beta build to install on your own Linux host. You need Docker, your
        own domain, and ports 80 and 443 available. Setup is manual, with hands-on support from the
        founder.
      </p>
      <p>
        <strong
          >This is not a hosted service and does not support single sign-on with your own identity
          provider.</strong
        >
      </p>
      <p>
        <button id="pay" class="checkout-page__pay" type="button"
          >Subscribe — ₹{rupees}/month</button
        >
      </p>
      <p id="state" class="checkout-page__state" aria-live="polite"></p>
      <p class="checkout-page__legal">
        Operated by Kartavya CSC Digital Seva. Before paying, you can read the
        <a href="/terms">Terms of Service</a>, <a href="/privacy">Privacy Policy</a>,
        <a href="/refunds">Refund and Cancellation Policy</a>,
        <a href="/delivery">Delivery Policy</a>, <a href="/contact">Contact</a> and
        <a href="/about">About</a> pages.
      </p>
    </article>
  </Container>
</Base>

<script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script is:inline>
  // R4-CHECKOUT: the one sanctioned client script. All state text goes through
  // say() so every outcome — including cancellation — is presented honestly.
  const say = (text) => {
    document.getElementById('state').textContent = text;
  };
  // R4-RETURN-PATH: a visitor arriving back from the bank lands here with
  // ?return=…; confirm against Razorpay itself before saying anything is paid.
  const returned = new URLSearchParams(window.location.search);
  if (returned.get('return') === 'paid' && returned.get('sub')) {
    say('Payment submitted — confirming with the payment provider…');
    fetch('/api/razorpay/subscription-status?id=' + encodeURIComponent(returned.get('sub')))
      .then((status) => (status.ok ? status.json() : null))
      .then((truth) => {
        if (truth && (truth.status === 'active' || truth.status === 'authenticated')) {
          say(
            'Payment received — subscription ' +
              truth.subscription_id +
              ' is ' +
              truth.status +
              '. A receipt follows from Razorpay.',
          );
        } else {
          say(
            'Your payment was submitted but is not confirmed yet (status: ' +
              (truth ? truth.status : 'unknown') +
              '). If money left your account it will reconcile.',
          );
        }
      })
      .catch(() => say('Your payment was submitted but confirmation could not be fetched.'));
  } else if (returned.get('return') === 'unverified') {
    say(
      'The return from the payment page could not be verified, so nothing is shown as paid. ' +
        'If you completed a payment it is still real — Razorpay will email a receipt.',
    );
  }

  document.getElementById('pay').addEventListener('click', async () => {
    say('Preparing your subscription…');
    let order;
    try {
      const created = await fetch('/api/razorpay/create-subscription', { method: 'POST' });
      if (!created.ok) {
        say('Payments are not available right now. Nothing was charged.');
        return;
      }
      order = await created.json();
    } catch {
      say('Payments are not available right now. Nothing was charged.');
      return;
    }

    const rzp = new Razorpay({
      key: order.key_id,
      subscription_id: order.subscription_id,
      name: 'Warrant Guardian',
      description: 'Monthly subscription',
      // R4-RETURN-PATH: bank-authentication pages (3DS) REDIRECT rather than
      // returning to the modal. callback_url brings the visitor home via
      // /api/razorpay/return, which verifies the subscription-flow signature
      // server-side before landing them here.
      callback_url: window.location.origin + '/api/razorpay/return',
      redirect: true,
      // RETURN-PATH / CALLBACK-NOT-INVOKED (2026-08-20): there is NO `handler`
      // here, deliberately. Razorpay's own option reference says `redirect`
      // decides "whether to post a response to the event handler post payment
      // completion OR redirect to Callback URL" — the two are alternatives,
      // and passing both left the choice to the library. Five real test
      // payments proved the consequence: the server callback was never
      // invoked, so no payment ever carried a return stamp, while the payer
      // (whose window closes on the demo-bank redirect) saw no confirmation
      // from the handler either. Redirect-only removes the ambiguity and is
      // the ONLY shape that survives the window closing: the browser posts to
      // /api/razorpay/return, which verifies the signature SERVER-SIDE before
      // anything is shown or recorded. The browser is still never believed —
      // the landing re-confirms with Razorpay via subscription-status.
      modal: {
        ondismiss: () => say('Checkout closed — nothing was charged. You can try again any time.'),
      },
    });
    rzp.on('payment.failed', (failure) => {
      say(
        'The payment did not go through (' +
          (failure.error && failure.error.description ? failure.error.description : 'declined') +
          '). Nothing was charged.',
      );
    });
    rzp.open();
  });
</script>

<style>
  .checkout-page {
    padding-block: var(--space-9);
    max-width: var(--measure-body);
  }
  .checkout-page__pay {
    font: inherit;
    font-weight: var(--weight-semibold);
    color: var(--accent-fg);
    background: var(--accent);
    border: none;
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
  }
  .checkout-page__pay:hover {
    background: var(--accent-hover);
  }
  .checkout-page__state {
    min-height: 1.6em;
    color: var(--fg-muted);
  }
  .checkout-page__legal {
    margin-block-start: var(--space-6);
    font-size: var(--type-small);
    color: var(--fg-muted);
  }
</style>
