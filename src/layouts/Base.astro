---
/**
 * Base.astro — <head>, skip link, header, landmarks, footer.
 *
 * Landmark map (`03` §5): banner x1, main x1, contentinfo x1.
 * All non-decorative content lives inside a landmark.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { meta, openGraph, PROVISIONAL } from '../content/copy';

interface Props {
  title: string;
  /** Empty string means "emit no description tag" — see /404. */
  description: string;
  canonicalPath: string;
  /** Whether this route is indexable *in production*. `04` §1. */
  indexable: boolean;
}

const { title, description, canonicalPath, indexable } = Astro.props;

/**
 * P0 `08` SEO-10 — noindex is enforced on every non-production build, driven by
 * the ENVIRONMENT variable at build time rather than by a hand-maintained file.
 *
 * The default is deliberately inverted from the specification's steady state:
 * an unconfigured build is NOT indexable. Nothing is deployed in this phase
 * (AWHQ-AUT-P1F P-01), so `production` should never be set here.
 */
const isProduction = process.env.ENVIRONMENT === 'production';
const robots = indexable && isProduction ? meta.robotsIndexable : meta.robotsNotIndexable;

const canonical = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <!-- `08` HTML-10 / `07` §9 — no maximum-scale, no user-scalable=no. Pinch zoom must work. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description !== '' && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!--
      `04` §8 — Open Graph. `og:image` and `og:image:alt` are deliberately absent:
      the OG image is a brand asset, and AWHQ-AUT-P1F P-15 prohibits any logo,
      wordmark, or brand asset while IP ownership is unevidenced.
    -->
    <meta property="og:type" content={openGraph.type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={openGraph.siteName} />
    <meta property="og:locale" content={openGraph.locale} />
    <meta property="og:title" content={openGraph.title} />
    <meta property="og:description" content={openGraph.description} />
    <meta name="twitter:card" content={openGraph.twitterCard} />

    <!--
      An empty data: icon, not a brand asset. It suppresses the browser's implicit
      /favicon.ico request, which would otherwise 404 (no favicon exists yet — P-15)
      and consume one of the <=6 first-load requests in `08` §8.
      Replace with the real favicon set once P-15 lifts.
    -->
    <link rel="icon" href="data:," />

    <!--
      Deliberately absent, each with a reason:
        - Organization JSON-LD (`08` SEO-07) requires a `logo` — blocked by P-15.
        - robots.txt / sitemap.xml naming a live host — blocked by P-14.
        - security.txt — needs a real contact and expiry — blocked by Open Item C.
        - site.webmanifest, apple-touch-icon, og-image — brand assets, blocked by P-15.
        - Web fonts — `08` §8 budget is zero, and `07` §3 specifies a system stack.
        - Analytics — blocked by P-06.
    -->
  </head>

  <body>
    <div class="page">
      <!--
        `03` Block 0 — first element in DOM inside <body>.
        Text is PROVISIONAL (GAP-01 in copy.ts): `04` specifies no skip-link
        string. Pending founder ratification.
      -->
      <a class="skip-link" href="#main">{PROVISIONAL.skipLinkText}</a>

      <SiteHeader />

      <main id="main" class="container">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
