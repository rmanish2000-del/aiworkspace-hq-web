# Environment variable names only. Values are ALWAYS empty in this file.
#
# Source: P0 `08-technical-requirements.md` §10, transcribed via P0 `11` §4.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ NO SECRET EXISTS IN THIS PHASE.                                         │
# │                                                                         │
# │ Every variable below belongs to a component excluded from the current   │
# │ authorized scope (AG-2-S). This file documents a future need. It is not │
# │ a credential store, and nothing in the current build reads any of it.   │
# │                                                                         │
# │ Governance: AWHQ-AUT-P1F v1.0 §6 (S-1…S-6).                             │
# │ Self-enforcing test (S-4): if a piece of work requires a secret, that   │
# │ work is out of scope.                                                   │
# └─────────────────────────────────────────────────────────────────────────┘

# --- Currently consumed by the build -------------------------------------

# Build. Canonical origin used for <link rel="canonical"> and Open Graph URLs.
# Source: P0 `04` §1. Defaults to https://aiworkspacehq.com when unset.
PUBLIC_SITE_URL=

# Build + server. `production` | `staging`.
# Drives the noindex directive (P0 `08` SEO-10) and, later, store selection.
# Defaults to `staging` when unset, so an unconfigured build is never indexable.
ENVIRONMENT=

# --- NOT consumed by the current build -----------------------------------
# Out of scope under AG-2-S. Listed so the future requirement is visible.

# Server. Submission store connection string. SECRET.
DATABASE_URL=

# Server. Durable rate-limit / escalation counters (P0 `05` §5.4). SECRET.
RATELIMIT_KV_URL=

# Server. Rotating 24h salt for the IP hash; never persisted. SECRET.
RATELIMIT_IP_SALT=


# Build + server. Published contact address.
PRIVACY_EMAIL=

# Server. Signs the form render timestamp (P0 `05` §5.2). SECRET.
FORM_HMAC_SECRET=

# Client. Bot-mitigation public key.
TURNSTILE_SITE_KEY=

# Server. Bot-mitigation verification key. SECRET.
TURNSTILE_SECRET_KEY=

RAZORPAY_KEY_ID:
RAZORPAY_KEY_SECRET:

# --- Razorpay (RAZORPAY-INTEGRATION, 2026-08-14) --------------------------
# TEST KEYS ONLY. The serverless handlers refuse any RAZORPAY_KEY_ID that does
# not start with rzp_test_, and tests/unit/razorpay.test.ts fails the build if a
# live key string ever enters the repository.
#
# LESSONS FROM THE FIRST TEST PAYMENT (2026-08-18), so the next person does
# not relearn them:
#   - If auth fails with values you believe are right, REGENERATE the key at
#     source (Razorpay dashboard) instead of re-pasting from a file — a stored
#     copy that is itself stale or corrupt reproduces the failure exactly.
#     GET /api/razorpay/readiness reports presence, secret length/whitespace
#     and a live upstream auth check without ever echoing a secret.
#   - The classic 4111 1111 1111 1111 test card is NOT eligible for RECURRING
#     payments. Subscriptions need a recurring-capable test card — take one
#     from Razorpay's own test-cards documentation page, not from memory.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Payer delivery (PAYER-GETS-SOMETHING, 2026-08-24) --------------------
# CONSUMED. Until these are set, a verified payment is recorded and stamped
# but NOBODY is written to: the payer gets only Razorpay's receipt and the
# founder learns of the customer by opening a dashboard. The webhook logs that
# at error level and writes `aiwhq_welcome: FAILED - no-email-provider-
# configured` onto the payment, so the gap is visible against the payment
# itself rather than silent.
#
# The sending domain must also be verified with the provider; an unverified
# sender is rejected and shows up as `provider-403`.

# Server. Transactional mail, send-only scope. SECRET.
RESEND_API_KEY=

# Server. Where the founder's own payment alert is delivered.
OPS_EMAIL=

# Server. From-address for both mails. Defaults to
# "AI Workspace <founder@aiworkspacehq.com>" when unset.
MAIL_FROM=

# Server. Shared secret Razorpay signs webhook bodies with. SECRET.
# Consumed by api/razorpay/webhook.mjs; it refuses every event without it.
RAZORPAY_WEBHOOK_SECRET=
