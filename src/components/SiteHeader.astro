---
/**
 * `03` Block 1 — Header. Product identity only.
 *
 * Composed from the design system: `Container` supplies the `07` §4 measure,
 * `Logo` supplies the wordmark. Neither the measure nor the wordmark string is
 * defined here, so neither can drift from its source.
 *
 * `03` §3 Block 1: no navigation, no CTA, no language switcher. The `Navigation`
 * component exists but is unapproved for this route — "Nothing to navigate to.
 * A menu with one item is noise." (`03` §2).
 */
import Container from './ui/Container.astro';
import Logo from './ui/Logo.astro';
---

<header class="site-header">
  <Container>
    <!--
      No `href`: `03` §3 Block 1 requires plain text while there is one page.
      An anchor to `#` is a focusable control that does nothing.
    -->
    <Logo />
  </Container>
</header>

<style>
  /* `07` §6.2 — padding block --space-5. No border, no shadow, not sticky. */
  .site-header {
    padding-block: var(--space-5);
  }
</style>
