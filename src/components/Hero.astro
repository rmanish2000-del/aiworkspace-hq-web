---
/**
 * `03` Block 2 — Hero.
 *
 * DOM order and semantics per `03` §3:
 *   1. Category label — a <p> styled as an eyebrow. NOT a heading; it carries
 *      no document-outline meaning.
 *   2. <h1> — the single h1 on the page.
 *   3. Supporting statement — <p>.
 *   4. Stage disclosure — <p>, visually distinct (`07` §6.4).
 *   5. Primary CTA — an in-page anchor to `#interest`, styled as a button.
 *   6. Secondary CTA — omitted at P0 (DEC-006). There is no second destination
 *      worth sending an enterprise buyer to. Copy is drafted in `04` §7 so that
 *      adding one later requires no new content decision.
 *
 * The CTA is an `<a href="#interest">` with its native link role left alone
 * (`07` §6.5). It moves within the page, so describing it as a button in the
 * accessibility tree would misdescribe it.
 *
 * `07` §7 additionally specifies that the CTA move focus to the form's first
 * field, not merely the scroll position. That requires JavaScript, and this
 * build ships none. The anchor targets the section, so a keyboard user lands on
 * the section heading and reaches the email field with one more Tab. Correct,
 * and one step short of the specified behaviour. Recorded in
 * docs/decisions/ADR-0003-visual-only-form.md.
 *
 * `03` §3 constraint: on a 375x667 viewport the eyebrow, h1, and at least the
 * first line of the supporting statement must be visible without scrolling.
 */
import { hero } from '../content/copy';
---

<section class="hero">
  <p class="eyebrow">{hero.eyebrow}</p>

  <h1 class="hero__headline">{hero.headline}</h1>

  <p class="hero__supporting">{hero.supporting}</p>

  <!-- Binding commitment C-11. Factual disclosure, not a warning banner (`07` §6.4). -->
  <p class="stage-disclosure">{hero.stageDisclosure}</p>

  <a class="button hero__cta" href="#interest" aria-label={hero.ctaAccessibleName}>
    {hero.ctaLabel}
  </a>
</section>
