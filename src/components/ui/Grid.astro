---
/**
 * Grid — responsive multi-column layout.
 *
 * ┌───────────────────────────────────────────────────────────────────────────┐
 * │ NOT APPROVED FOR THE CURRENT ROUTES.                                      │
 * │                                                                           │
 * │ `07` §4 is explicit: "single column at every breakpoint ... no grid        │
 * │ framework, no CSS framework, no utility-class library." Using this on `/`  │
 * │ or `/404` contradicts an approved specification.                          │
 * │                                                                           │
 * │ It exists for the surfaces `08` C9 anticipates — documentation,            │
 * │ developers, API, SDK, blog, trust centre, academy — which is the same      │
 * │ reasoning that made Astro the right framework (TDR-01 C9). Building the    │
 * │ primitive now costs nothing; using it early costs a specification breach.  │
 * └───────────────────────────────────────────────────────────────────────────┘
 *
 * Provenance: EXTENSION.
 * Accessibility:
 *   - `display: grid` on a `<ul>` removes list semantics in some screen
 *     readers; when `as="ul"` the component restores them with
 *     `role="list"`.
 *   - columns collapse to one below the `sm` breakpoint, so reflow at 320px
 *     (`08` A11Y-05) holds without the caller doing anything.
 * JavaScript: none.
 */
import type { GridColumns, SpaceStep } from '../../lib/tokens';

export interface Props {
  as?: 'div' | 'ul' | 'ol' | 'section';
  /** Column count at the `sm` breakpoint and above. One column below it. */
  columns?: GridColumns;
  /** Gap between cells, as a step on the `07` §4 spacing scale. */
  gap?: SpaceStep;
  class?: string;
}

const { as: Tag = 'div', columns = 2, gap = 6, class: className } = Astro.props;

// A <ul> with display:grid loses list semantics in Safari + VoiceOver.
const listRole = Tag === 'ul' || Tag === 'ol' ? 'list' : undefined;

const style = `--grid-columns: ${columns}; --grid-gap: var(--space-${gap})`;
---

<Tag class:list={['grid', className]} role={listRole} style={style}>
  <slot />
</Tag>

<style>
  .grid {
    display: grid;
    /* `07` §5 — one column below 640px, always. */
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }
  }
</style>
