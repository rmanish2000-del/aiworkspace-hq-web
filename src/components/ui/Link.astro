---
/**
 * Link — a body-text link.
 *
 * `07` §6.12: accent colour, underlined with `text-underline-offset: 0.2em`
 * and `text-decoration-thickness: 1px`, thickening to 2px on hover.
 *
 * **The underline is never removed.** `07` §2: colour is never the sole carrier
 * of meaning, so a link that is only coloured is a defect, not a style choice.
 *
 * Provenance: CANONICAL.
 * Accessibility:
 *   - `external` adds `rel="noopener noreferrer"`. It does NOT add
 *     `target="_blank"`: opening a new window unannounced is a WCAG 3.2.5
 *     problem, and no approved copy warns the reader that it will happen.
 *   - no `title` attribute is ever emitted — `08` HTML-07 forbids using it to
 *     convey information.
 * JavaScript: none.
 */
export interface Props {
  href: string;
  /** Marks an off-site destination; adds rel, never target. */
  external?: boolean;
  'aria-label'?: string;
  class?: string;
}

const { href, external = false, 'aria-label': ariaLabel, class: className } = Astro.props;
---

{
  /*
  The slot sits flush against the tags on purpose. Formatting it across lines
  puts whitespace text nodes inside the anchor, which renders as a space before
  the following punctuation — "register interest ." instead of
  "register interest." — and underlines that space. Prettier preserves this
  because significant whitespace in inline elements is not safe to reflow.
*/
}<a
  class:list={['link', className]}
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={ariaLabel}><slot /></a
>

<style>
  /*
   * P1-M defect A11Y-09-2. A text link's box is only as tall as its line, which
   * is under the SC 2.5.8 24px minimum. Links flowing inside a sentence are
   * covered by the inline exception, but three of these sit alone in their own
   * paragraph (`/contact` privacy link, `/privacy` back link, `/` footer link)
   * where that exception is arguable at best.
   *
   * Vertical padding on a non-replaced INLINE element does not affect line-box
   * height, so this grows the hit box without changing the rendered layout at
   * all. No background is painted, so there is no visual change either.
   *
   * 4px, not 2px — defect A11Y-09-3. The first fix was calibrated against
   * Windows font metrics, where the line box is 21px and 2px each side reached
   * 25px. CI on Linux renders the same text at 18-19px, so the same rule landed
   * at 22-23px and was still short. 4px clears 24px on both (26-29px) and holds
   * for any font whose line box is at least 16px.
   *
   * The lesson is in the margin: a target-size fix measured on one platform's
   * fonts is not a fix. This one was caught only because CI runs Linux.
   */
  .link {
    padding-block: 4px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness var(--duration-fast) var(--ease);
  }

  .link:hover {
    text-decoration-thickness: 2px;
  }

  .link:focus-visible {
    outline: var(--focus-ring-width) solid var(--accent);
    outline-offset: var(--focus-ring-offset);
  }
</style>
