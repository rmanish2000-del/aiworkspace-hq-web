---
/**
 * Tag — a categorisation label.
 *
 * ┌───────────────────────────────────────────────────────────────────────────┐
 * │ ⛔ NOT APPROVED FOR THE CURRENT ROUTES. Built because P1-I asks for it.    │
 * │                                                                           │
 * │ Visually a Tag is a pill, so `07` §1's rejection of badges and §6.3's      │
 * │ "a pill would read as a status chip" both bear on it.                     │
 * │                                                                           │
 * │ It is separated from Badge because the two mean different things, and     │
 * │ conflating them is how a taxonomy label turns into a maturity claim:      │
 * │                                                                           │
 * │   Badge  asserts a STATE of the thing it sits beside ("Beta", "New").     │
 * │          Almost always a claim, and `02` §3 prohibits most of them.       │
 * │                                                                           │
 * │   Tag    asserts a CATEGORY the thing belongs to ("Guide", "Reference").  │
 * │          Not a claim about maturity, so it is the safer of the two — but  │
 * │          still unapproved, because the pill treatment itself is.          │
 * │                                                                           │
 * │ Intended for the documentation and blog surfaces `08` C9 anticipates.     │
 * └───────────────────────────────────────────────────────────────────────────┘
 *
 * Provenance: EXTENSION, unapproved.
 * Accessibility:
 *   - a list of tags is a list. Render them inside a `<ul>` so their number is
 *     announced, rather than as loose inline text.
 *   - when a Tag links to a filtered view it must be an `<a>` with a real
 *     destination, and then it needs a 44x44 touch target (`07` §9). The
 *     component does not do this for you.
 * JavaScript: none.
 */
export interface Props {
  /** `a` requires `href`. A Tag with no destination is not a control. */
  as?: 'span' | 'li' | 'a';
  href?: string;
  class?: string;
}

const { as: Tag = 'span', href, class: className } = Astro.props;
const isLink = Tag === 'a';
---

<Tag class:list={['tag', isLink && 'tag--link', className]} href={isLink ? href : undefined}>
  <slot />
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background-color: var(--bg-subtle);
    font-size: var(--type-small);
    line-height: 1.4;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .tag--link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    /* `07` §9 — a real target when it is a real control. */
    min-height: 44px;
    padding-inline: var(--space-3);
  }

  .tag--link:focus-visible {
    outline: var(--focus-ring-width) solid var(--accent);
    outline-offset: var(--focus-ring-offset);
  }
</style>
