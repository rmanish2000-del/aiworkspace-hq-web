---
/**
 * `/pricing` — sealed-price only (PRICING-SCAFFOLD). Live availability
 * line from B1 (2026-08-21). Words and capability ship together.
 */
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import { sealedPrice } from '../../config/pricing';
import { pricingPage } from '../../content/pricing-page';

export function getStaticPaths() {
  const price = sealedPrice();
  return price.publish ? [{ params: { index: undefined } }] : [];
}

const price = sealedPrice();
if (!price.publish) throw new Error('unreachable: getStaticPaths emitted no path');
const rupees = price.inr.toLocaleString('en-IN');
const dollars = price.usd.toLocaleString('en-US');
---

<Base
  title={pricingPage.metaTitle}
  description={pricingPage.metaDescription}
  canonicalPath="/pricing"
  indexableInProduction={false}
>
  <Container>
    <article class="pricing-page">
      <h1>{pricingPage.heading}</h1>
      <p>
        {pricingPage.priceLeadBefore}<strong>₹{rupees} {pricingPage.perMonth}</strong>{
          pricingPage.gstNote
        }
        <span class="pricing-page__usd"
          >({pricingPage.about} ${dollars} {pricingPage.perMonth})</span
        >.
      </p>
      <p class="pricing-page__offer">{pricingPage.offer}</p>
      <p class="pricing-page__not-for"><strong>{pricingPage.notFor}</strong></p>
      <section class="pricing-page__example" aria-labelledby="pricing-example-heading">
        <h2 id="pricing-example-heading">{pricingPage.exampleHeading}</h2>
        <p>{pricingPage.exampleLead}</p>
        <dl>
          <div>
            <dt>{pricingPage.exampleCommandLabel}</dt>
            <dd><code>{pricingPage.exampleCommand}</code></dd>
          </div>
          <div>
            <dt>{pricingPage.examplePolicyLabel}</dt>
            <dd>{pricingPage.examplePolicy}</dd>
          </div>
          <div>
            <dt>{pricingPage.exampleOutcomeLabel}</dt>
            <dd><strong>{pricingPage.exampleOutcome}</strong></dd>
          </div>
        </dl>
      </section>
      <p class="pricing-page__availability">
        {pricingPage.subscribeAt}
        <a href="/checkout">/checkout</a>. {pricingPage.questionsBeforePay}
        <a href="mailto:founder@aiworkspacehq.com">founder@aiworkspacehq.com</a>
        {pricingPage.monitored}
      </p>
      <p class="pricing-page__seal">
        {pricingPage.sealLead}
        {price.seal.date}.
      </p>
    </article>
  </Container>
</Base>

<style>
  .pricing-page {
    padding-block: var(--space-9);
    max-width: var(--measure-body);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .pricing-page__availability {
    font-weight: var(--weight-semibold);
    margin-block-start: var(--space-2);
    overflow-wrap: anywhere;
  }
  .pricing-page__offer,
  .pricing-page__not-for {
    margin-block-start: var(--space-4);
  }
  .pricing-page__example {
    margin-block-start: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }
  .pricing-page__example h2 {
    font-size: var(--type-h3);
  }
  .pricing-page__example p,
  .pricing-page__example dl {
    margin-block-start: var(--space-3);
  }
  .pricing-page__example dl {
    display: grid;
    gap: var(--space-3);
  }
  .pricing-page__example dt {
    color: var(--fg-muted);
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
  }
  .pricing-page__example dd {
    margin: 0;
  }
  .pricing-page__seal {
    color: var(--fg-muted);
    font-size: var(--type-small);
  }
  .pricing-page__usd {
    overflow-wrap: anywhere;
  }
</style>
