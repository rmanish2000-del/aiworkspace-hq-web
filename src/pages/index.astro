---
/**
 * `/` — the home route.
 *
 * Blocks rendered (`03` §2):
 *   0  Skip link      — Base.astro
 *   1  Header + nav   — Base.astro -> SiteHeader (nav is new: P1-J §4.1)
 *   2  Hero           — here
 *   3  Principles     — here
 *   4  Early interest — here, VISUAL ONLY. No submission path exists.
 *   5  Footer         — Base.astro -> SiteFooter (landmark only; copy blocked)
 *
 * All six blocks of `03` §2 are now present, in order.
 *
 * Document outline, matching `03` §4 exactly:
 *
 *   h1  The layer between your enterprise systems and your AI agents
 *    h2  How we are building it
 *      h3 Connect before migrate
 *      h3 Understand before automate
 *      h3 Extend before replace
 *      h3 Reuse before rebuild
 *      h3 Evidence before claims
 *    h2  Register interest
 *
 * Exactly one h1. No heading levels skipped. Asserted by
 * tests/e2e/structure.spec.ts against the built output.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import InterestForm from '../components/InterestForm.astro';
import { meta } from '../content/copy';
---

<Base
  title={meta.titleHome}
  description={meta.descriptionHome}
  canonicalPath={meta.canonicalPathHome}
  indexableInProduction={true}
  structuredData={true}
>
  <Hero />
  <Principles />
  <InterestForm />
</Base>
