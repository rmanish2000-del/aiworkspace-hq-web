---
import { experience, nav, privacy, products } from '../content/copy';
import Container from './ui/Container.astro';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const footer = experience.footer;

const groups = [
  {
    label: footer.explore,
    links: [
      { href: '/platform', label: 'Platform' },
      { href: products.canonicalPath, label: 'Products' },
      { href: '/enterprise', label: nav.enterprise },
    ],
  },
  {
    label: footer.verify,
    links: [
      { href: '/trust', label: 'Trust' },
      { href: '/technology', label: 'Technology' },
      { href: '/what-we-havent-built', label: 'What we have not built' },
      { href: '/security', label: nav.security },
    ],
  },
  {
    label: footer.engage,
    links: [
      { href: '/about', label: nav.about },
      { href: '/principles', label: 'Principles' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: privacy.heading },
      { href: '/warrant/console', label: nav.warrant },
    ],
  },
] as const;
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">AI Workspace</p>
        <p>{footer.statement}</p>
        <p class="site-footer__status">{footer.status}</p>
      </div>
      {
        groups.map((group) => (
          <nav aria-label={group.label}>
            <h2>{group.label}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-9);
    border-block-start: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-8);
  }

  .site-footer__brand {
    max-width: 34ch;
  }

  .site-footer__wordmark {
    font-size: var(--type-h3);
    font-weight: var(--weight-semibold);
  }

  .site-footer__brand > p:not(.site-footer__wordmark) {
    margin-block-start: var(--space-3);
    color: var(--fg-muted);
  }

  .site-footer__status {
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--accent);
    font-size: var(--type-small);
  }

  .site-footer h2 {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a[aria-current='page'] {
    text-decoration: underline;
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .site-footer__grid {
      grid-template-columns: minmax(260px, 1.5fr) repeat(3, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
