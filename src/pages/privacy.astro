---
/**
 * `/privacy` — PUBLISH-GUARDIAN-PAGES (2026-08-11). CONTENT-FROZEN ROUTE.
 *
 * The prose below renders from `src/legal/privacy.md`, one of the six
 * merchant-verification pages. The text is under a founder content freeze:
 * scans A, B and C pass against the BUILT output, and the freeze check
 * fails the build if the rendered text drifts without an explicit founder
 * authorisation. The entity block (legal name, address, GSTIN, Udyam) is
 * CONTENT, not chrome — merchant verification reads it off the page.
 */
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import { Content } from '../legal/privacy.md';
---

<Base
  title="Privacy Policy"
  description="What Warrant Guardian collects, why, and for how long."
  canonicalPath="/privacy/"
  indexableInProduction={true}
>
  <Container>
    <article class="legal-page">
      <h1>Privacy Policy</h1>
      <Content />
    </article>
  </Container>
</Base>
