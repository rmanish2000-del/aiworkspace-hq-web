---
/**
 * `/refunds` — PUBLISH-GUARDIAN-PAGES (2026-08-11). CONTENT-FROZEN ROUTE.
 *
 * The prose below renders from `src/legal/refunds.md`, one of the six
 * merchant-verification pages. The text is under a founder content freeze:
 * scans A, B and C pass against the BUILT output, and the freeze check
 * fails the build if the rendered text drifts without an explicit founder
 * authorisation. The entity block (legal name, address, GSTIN, Udyam) is
 * CONTENT, not chrome — merchant verification reads it off the page.
 */
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import { Content } from '../../legal/refunds.md';
---

<Base
  title="Refund and Cancellation Policy"
  description="How cancellation and refunds work for Warrant Guardian."
  canonicalPath="/warrant-guardian/refunds"
  indexableInProduction={true}
>
  <Container>
    <article class="legal-page">
      <h1>Refund and Cancellation Policy</h1>
      <Content />
    </article>
  </Container>
</Base>

<style>
  /* FIX-A11Y-06 (2026-08-11): the merchant pages carry long unbreakable
     tokens - GSTIN, Udyam number, the contact email - and at 320px with the
     SC 1.4.12 text-spacing overrides applied they pushed /privacy into a
     sideways scroll. `anywhere` lets those tokens break; prose is
     unaffected. Layout-only: no frozen text changes. */
  .legal-page {
    overflow-wrap: anywhere;
  }
</style>
