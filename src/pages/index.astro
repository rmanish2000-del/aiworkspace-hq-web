---
/**
 * `/` — the home route.
 *
 * Blocks rendered (`03` §2):
 *   0  Skip link      — Base.astro
 *   1  Header         — Base.astro -> SiteHeader
 *   2  Hero           — here
 *   3  Principles     — here
 *   4  Early interest — NOT BUILT. The authorized assignment excludes forms;
 *                       AWHQ-AUT-P1F MF-1/MF-2 exclude any submission path.
 *   5  Footer         — Base.astro -> SiteFooter (landmark only; copy blocked)
 *
 * Resulting document outline, against `03` §4:
 *
 *   h1  The layer between your enterprise systems and your AI agents
 *    h2  How we are building it
 *      h3 Connect before migrate
 *      h3 Understand before automate
 *      h3 Extend before replace
 *      h3 Reuse before rebuild
 *      h3 Evidence before claims
 *    h2  Register interest              <-- ABSENT in this scope (Block 4)
 *
 * Exactly one h1. No heading levels skipped. The deviation is the trailing h2
 * only, and it is recorded in docs/decisions/ADR-0002-scope-deviations.md.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import { meta } from '../content/copy';
---

<Base
  title={meta.titleHome}
  description={meta.descriptionHome}
  canonicalPath={meta.canonicalPathHome}
  indexable={true}
>
  <Hero />
  <Principles />
</Base>
