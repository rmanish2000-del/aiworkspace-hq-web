---
/**
 * Base.astro — <head>, skip link, header, landmarks, footer.
 *
 * Landmark map (`03` §5): banner x1, main x1, contentinfo x1.
 * All non-decorative content lives inside a landmark.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { meta, openGraph, PROVISIONAL } from '../content/copy';
import { IS_INDEXABLE, canonicalUrl } from '../lib/site';

interface Props {
  title: string;
  /** Empty string means "emit no description tag" — see /404. */
  description: string;
  canonicalPath: string;
  /** Whether this route would be indexable once a production deploy exists. */
  indexableInProduction: boolean;
}

const { title, description, canonicalPath, indexableInProduction } = Astro.props;

/**
 * P0 `08` SEO-10. `IS_INDEXABLE` is a constant `false`: nothing is deployed and
 * P-01 forbids deploying, so there is no environment in which this build should
 * be indexable. The per-route flag is carried through so the intent survives to
 * the phase where it matters, but it cannot make a route indexable on its own.
 */
const robots =
  indexableInProduction && IS_INDEXABLE ? meta.robotsIndexable : meta.robotsNotIndexable;

const canonical = canonicalUrl(canonicalPath);
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <!-- `08` HTML-10 / `07` §9 — no maximum-scale, no user-scalable=no. Pinch zoom must work. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description !== '' && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!--
      `04` §8 — Open Graph. `og:image` and `og:image:alt` are deliberately absent:
      the OG image is a brand asset, and AWHQ-AUT-P1F P-15 prohibits any logo,
      wordmark, or brand asset while IP ownership is unevidenced.
    -->
    <meta property="og:type" content={openGraph.type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={openGraph.siteName} />
    <meta property="og:locale" content={openGraph.locale} />
    <meta property="og:title" content={openGraph.title} />
    <meta property="og:description" content={openGraph.description} />
    <meta name="twitter:card" content={openGraph.twitterCard} />

    <!--
      PLACEHOLDER favicon and manifest. Neither is a brand asset: the icon is a
      plain geometric glyph carrying no wordmark, monogram, or logotype, and the
      manifest names the product using the approved public string only.

      `07` §11 suggests an "AI" monogram for the real favicon. That is
      deliberately NOT used here — a monogram is a brand asset, and P-15 blocks
      brand assets while IP ownership is unevidenced (Open Item E). Replace both
      files, do not edit them in place, when P-15 lifts.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d0e" media="(prefers-color-scheme: dark)" />

    <!--
      Deliberately absent, each with a reason:
        - Organization JSON-LD (`08` SEO-07) requires a `logo` — blocked by P-15.
        - robots.txt / sitemap.xml naming a live host — blocked by P-14.
        - security.txt — needs a real contact and expiry — blocked by Open Item C.
        - og-image, apple-touch-icon, wordmark SVG — brand assets, blocked by P-15.
        - Web fonts — `08` §8 budget is zero, and `07` §3 specifies a system stack.
        - Analytics — blocked by P-06.
        - Any script. This build ships zero bytes of client JavaScript.
    -->
  </head>

  <body>
    <div class="page">
      <!--
        `03` Block 0 — first element in DOM inside <body>.
        Text is PROVISIONAL (GAP-01 in copy.ts): `04` specifies no skip-link
        string. Pending founder ratification.
      -->
      <a class="skip-link" href="#main">{PROVISIONAL.skipLinkText}</a>

      <SiteHeader />

      <main id="main" class="container">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
