---
/**
 * `/warrant-mcp` — one page, whole product. Docs-site plain.
 *
 * ┌───────────────────────────────────────────────────────────────────────────┐
 * │ EVERY VISIBLE STRING COMES FROM `src/content/copy.ts` (M-9).              │
 * │                                                                           │
 * │ There is no prose in this file. The words are verbatim in the module and  │
 * │ are not edited here — not for length, not for rhythm, not for a line that │
 * │ sits awkwardly. This file decides markup; `copy.ts` decides wording.      │
 * └───────────────────────────────────────────────────────────────────────────┘
 *
 * How inline markup survives M-9. A paragraph carrying an inline `<code>` span
 * is several text nodes, and M-9 walks text nodes. Rather than shattering each
 * sentence into a dozen keys, the whole sentence is stored once and `CopyLine`
 * marks named spans inside it; every fragment rendered is then a substring of
 * the stored sentence, which M-9 accepts. `about.astro` already leans on the
 * same property when it splits its contact lead around two inline links, and
 * the two links here are split with exactly that idiom.
 *
 * Markup decisions taken here, and why:
 *
 *  1. The source copy opens `# warrant-mcp` then `## Rules your agent cannot
 *     talk its way past`. That second line is the deck, not a section, so it
 *     renders as the page lead. Keeping it an `<h2>` would put the tagline in
 *     the heading outline beside the real sections and make the outline lie
 *     about the page's shape.
 *
 *  2. Code blocks are real text in a `<pre>`, so they can be selected and
 *     copied. There is no copy *button*: `Base.astro` ships zero bytes of
 *     client JavaScript. `white-space: pre` with `overflow-x: auto` means the
 *     DENY block scrolls rather than reflows — a rewrapped refusal is a
 *     different sentence.
 *
 *  3. Limitations is body copy at the same weight as every other section. No
 *     callout, no disclosure, no warning colour. A page that visually
 *     quarantines its own limitations has un-said them.
 *
 * Not done, deliberately: no nav entry either way, and not added to
 * `/sitemap.xml` — that list is an explicit five-route allowlist (FD-AG4 wave
 * 1) and extending it is a governance decision, not a markup one.
 */
import Base from '../layouts/Base.astro';
import CopyLine from '../components/CopyLine.astro';
import { meta, warrantMcp as w } from '../content/copy';

const CARD = '/warrant-mcp/og-1200x630.png';

/** The `about.astro` idiom: one approved sentence, split around its links. */
const [beforeNpm, afterNpm] = w.metaLine.split(w.npmLinkText) as [string, string];
const [betweenLinks, afterSource] = afterNpm.split(w.sourceLinkText) as [string, string];
const [beforeLog, afterLog] = w.evidenceLog.split(w.evidenceLogLinkText) as [string, string];
const [beforePost, afterPost] = w.evidencePost.split(w.evidencePostLinkText) as [string, string];
const [beforeProject, afterProject] = w.provenance.split(w.provenanceLinkText) as [string, string];

/** Which spans each sentence renders as `<code>`. Markup, not wording. */
const stepCode: readonly (readonly string[])[] = [
  ['.warrant/policy.md'],
  [],
  [],
  ['PreToolUse', '--allowedTools'],
  [],
];
const stepStrong: readonly (readonly string[])[] = [
  [],
  ['once, off stage'],
  [],
  [],
  ['The model never makes the runtime call.'],
];
const limitCode: readonly (readonly string[])[] = [
  ['rm -f *', '$VAR', 'xargs', 'git clean -fdx', 'git checkout .', 'make clean'],
  ["'.'+'env'"],
  ['realpath'],
  [],
  ['Edit', '{}'],
  [],
  [],
  [],
  [],
  ['node demo/bench.mjs'],
];
/** The bold lead-in of each limitation is its first sentence — a substring. */
const leadIn = (text: string): string => text.slice(0, text.indexOf('.') + 1);
---

<Base
  title={w.metaTitle}
  description={meta.descriptionHome}
  canonicalPath={w.canonicalPath}
  indexableInProduction={true}
  ogImage={CARD}
  ogImageAlt={w.cardAlt}
>
  <article class="prose wmcp">
    <h1 class="page-head__title">{w.heading}</h1>
    <p class="page-head__lead">{w.lead}</p>

    <p>{w.introOne}</p>
    <p>{w.introTwo}</p>
    <p>{w.introThree}</p>

    <p class="prose__meta">
      {beforeNpm}<a href="https://www.npmjs.com/package/warrant-mcp" rel="external"
        >{w.npmLinkText}</a
      >{betweenLinks}<a href="https://github.com/rmanish2000-del/warrant-mcp" rel="external"
        >{w.sourceLinkText}</a
      >{afterSource}
    </p>

    <figure class="wmcp-card">
      <img src={CARD} width="1200" height="630" alt={w.cardAlt} loading="lazy" decoding="async" />
    </figure>

    <h2 id="sixty-seconds">{w.sixtyHeading}</h2>
    <p>{w.sixtyLead}</p>
    <pre
      class="wmcp-code"
      tabindex="0"
      aria-label={w.installBlockLabel}><code>{w.installBlock}</code></pre>
    <p>{w.thirdPrints}</p>
    <pre
      class="wmcp-code wmcp-code--deny"
      tabindex="0"
      aria-label={w.denyBlockLabel}><code>{w.denyBlock}</code></pre>
    <p><CopyLine text={w.initReturns} code={['init']} strong={['enforcing']} /></p>
    <p><CopyLine text={w.timings} code={['npm install', 'init']} /></p>
    <p><CopyLine text={w.hookForReal} code={['.env']} /></p>

    <h2 id="how-it-works">{w.howHeading}</h2>
    <ol class="wmcp-steps">
      {
        w.howSteps.map((step, i) => (
          <li>
            <CopyLine text={step} code={stepCode[i]} strong={stepStrong[i]} />
          </li>
        ))
      }
    </ol>
    <p><CopyLine text={w.howStructural} code={["Omit<CompiledPolicy, 'clauses'>"]} /></p>
    <p>{w.howVerdicts}</p>

    <h2 id="writing-the-policy">{w.skillHeading}</h2>
    <p><CopyLine text={w.skillOne} code={['warrant-policy-author']} /></p>
    <p>
      <CopyLine text={w.skillTwo} code={['.claude/skills/', 'init --skill', 'remove', 'init']} />
    </p>
    <pre
      class="wmcp-code"
      tabindex="0"
      aria-label={w.pluginBlockLabel}><code>{w.pluginBlock}</code></pre>
    <p>
      <CopyLine
        text={w.skillAuthority}
        code={['warrant-mcp review']}
        strong={[
          'The skill writes policy text only. It never enforces anything, and it never claims a sentence will compile.',
        ]}
      />
    </p>
    <p>{w.skillLooksLike}</p>
    <blockquote class="wmcp-quote"><p>{w.skillFirstAttempt}</p></blockquote>
    <p>{w.skillWhyRefused}</p>
    <blockquote class="wmcp-quote">
      <ol>{w.skillRewritten.map((line) => <li>{line}</li>)}</ol>
    </blockquote>
    <p>{w.skillSameProtections}</p>

    <h2 id="where-the-policy-lives">{w.vaultHeading}</h2>
    <p><CopyLine text={w.vaultBody} code={['~/.warrant/projects/<project>/']} /></p>

    <h2 id="changing-the-rules">{w.changingHeading}</h2>
    <p><CopyLine text={w.changingLead} code={['.warrant/policy.md']} /></p>
    <pre
      class="wmcp-code"
      tabindex="0"
      aria-label={w.reviewBlockLabel}><code>{w.reviewBlock}</code></pre>
    <p>
      <CopyLine
        text={w.changingOnly}
        code={['review', 'ANTHROPIC_API_KEY']}
        strong={['only', 'Enforcement never compiles']}
      />
    </p>
    <p>{w.changingShows}</p>
    <p><CopyLine text={w.changingRefuses} strong={['the whole policy']} /></p>

    <h2 id="undoing-it">{w.undoHeading}</h2>
    <pre
      class="wmcp-code"
      tabindex="0"
      aria-label={w.removeBlockLabel}><code>{w.removeBlock}</code></pre>
    <p><CopyLine text={w.undoBody} code={['init']} /></p>
    <p>{w.undoTry}</p>

    <h2 id="limitations">{w.limitsHeading}</h2>
    <p><strong>{w.limitsLede}</strong></p>
    <p>{w.limitsIntro}</p>
    {
      w.limits.map((limit, i) => (
        <p>
          <CopyLine text={limit} code={limitCode[i]} strong={[leadIn(limit)]} />
        </p>
      ))
    }
    <p>{w.limitsDeployment}</p>

    <h2 id="the-evidence">{w.evidenceHeading}</h2>
    <p>
      {beforeLog}<a
        href="https://github.com/rmanish2000-del/warrant-mcp/blob/main/SECURITY-SURFACE.md"
        rel="external">{w.evidenceLogLinkText}</a
      >{afterLog}
    </p>
    <p>
      {beforePost}<strong
        ><a
          href="https://github.com/rmanish2000-del/warrant-mcp/blob/main/writing/bypass-hunt.md"
          rel="external">{w.evidencePostLinkText}</a
        ></strong
      >{afterPost}
    </p>
    <p>{w.evidenceLesson}</p>

    <p class="wmcp-provenance">
      <em
        >{beforeProject}<a href="https://github.com/rmanish2000-del/warrant" rel="external"
          >{w.provenanceLinkText}</a
        >{afterProject}</em
      >
    </p>
  </article>
</Base>

<style>
  /*
   * Page-scoped only. Nothing here introduces a colour: every value is a token
   * from the design system, so the page follows the light/dark switch without
   * knowing it exists.
   */

  /*
   * Inline code must be breakable. Tokens like Omit<CompiledPolicy, 'clauses'>
   * and ~/.warrant/projects/<project>/ have no break opportunity, so at a 320px
   * viewport with SC 1.4.12's forced letter- and word-spacing they push past the
   * edge and the PAGE scrolls sideways — content becomes unreachable rather than
   * merely overflowing a box. Measured: five inline <code> right edges at 346px
   * to 738px against a 320px limit.
   *
   * The block form is exempted below: there, alignment is the content.
   */
  code {
    overflow-wrap: anywhere;
  }

  /* --- Code -------------------------------------------------------------- */
  /*
   * Scroll, never wrap. A reflowed refusal is a different sentence, and the
   * clause line is the one thing on this page a reader is asked to trust.
   * `tabindex` + `` make a scrollable box reachable by keyboard,
   * which it must be if it can scroll at all.
   */
  .wmcp-code {
    margin-block-start: var(--space-5);
    padding: var(--space-4) var(--space-5);
    max-width: 100%;
    overflow-x: auto;
    background: var(--bg-subtle);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--type-small);
    line-height: 1.65;
    white-space: pre;
    tab-size: 2;
  }

  .wmcp-code code {
    font: inherit;
    background: none;
    padding: 0;
    /* Not `anywhere`: the block scrolls instead of breaking a line. */
    overflow-wrap: normal;
  }

  .wmcp-code:focus-visible {
    outline: var(--focus-ring-width) solid var(--accent);
    outline-offset: var(--focus-ring-offset);
  }

  /*
   * The DENY block is the page's one piece of evidence. It gets the accent as a
   * left edge and nothing else — no tint, no red, no alarm. The word DENY does
   * its own work.
   */
  .wmcp-code--deny {
    border-inline-start: 3px solid var(--accent);
  }

  /* --- The social card --------------------------------------------------- */
  .wmcp-card {
    margin-block-start: var(--space-7);
    margin-inline: 0;
    max-width: 100%;
  }

  .wmcp-card img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  /* --- Numbered steps and quoted policy sentences ------------------------ */
  .wmcp-steps {
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-6);
    list-style: decimal;
  }

  .wmcp-steps > li {
    margin-block-start: var(--space-3);
  }

  .wmcp-quote {
    margin-block-start: var(--space-5);
    margin-inline: 0;
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--border-input);
    color: var(--fg-muted);
  }

  .wmcp-quote ol {
    margin: 0;
    padding-inline-start: var(--space-5);
    list-style: decimal;
  }

  .wmcp-quote li + li {
    margin-block-start: var(--space-2);
  }

  /* --- The provenance line ----------------------------------------------- */
  /*
   * The only reference between this page and /warrant. Quieter than body copy,
   * and not a navigation affordance.
   */
  .wmcp-provenance {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
    font-size: var(--type-small);
    color: var(--fg-muted);
  }
</style>
