---
/**
 * Base.astro — <head>, skip link, header, nav, landmarks, footer.
 *
 * Landmark map (`03` §5, extended by P1-J §4.4):
 *   banner ×1 · navigation (named) · main ×1 · contentinfo ×1
 *
 * P1-J §4.4 tab order, on every route:
 *   skip link → wordmark → nav items → main content → footer
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/ui/Container.astro';
import { meta, openGraph, PROVISIONAL } from '../content/copy';
import { IS_INDEXABLE, canonicalUrl } from '../lib/site';
import { organizationJsonLd } from '../lib/structured-data';

interface Props {
  title: string;
  /** Empty string means "emit no description tag" — see /404. */
  description: string;
  canonicalPath: string;
  /** Whether this route would be indexable once a production deploy exists. */
  indexableInProduction: boolean;
  /**
   * `Organization` JSON-LD. P1-J §4.3: on `/` ONLY, and `Organization` only —
   * no `Product`, `SoftwareApplication`, `AggregateRating`, `Offer`,
   * `FAQPage`, `BreadcrumbList` or `Article` (DEC-031). Each of those would
   * assert something `02` §3 prohibits.
   */
  structuredData?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  indexableInProduction,
  structuredData = false,
} = Astro.props;

/**
 * P0 `08` SEO-10. `IS_INDEXABLE` is a constant `false`: nothing is deployed and
 * P-01 forbids deploying, so there is no environment in which this build should
 * be indexable. The per-route flag is carried through so the intent survives to
 * the phase where it matters, but it cannot make a route indexable on its own.
 */
const robots =
  indexableInProduction && IS_INDEXABLE ? meta.robotsIndexable : meta.robotsNotIndexable;

const canonical = canonicalUrl(canonicalPath);

/**
 * Serialised once, in `src/lib/structured-data.ts`, so that the CSP hash in
 * `src/lib/production.ts` is computed over exactly the bytes rendered here.
 */
const jsonLd = organizationJsonLd(meta.descriptionHome);

/** `04` §8 — one social card for every route; no per-route imagery. */
const ogImage = canonicalUrl('/og-image.png');
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    {/* `08` HTML-10 / `07` §9 — no maximum-scale, no user-scalable=no. Pinch zoom must work. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description !== '' && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    {
      /*
      `04` §8 / P1-J §4.3 — Open Graph. One card for every route; no per-route
      imagery. `og:image` and `og:image:alt` are deliberately absent: the OG
      image is a brand asset, and P-15 blocks brand assets while IP ownership
      is unevidenced.
    */
    }
    <meta property="og:type" content={openGraph.type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={openGraph.siteName} />
    <meta property="og:locale" content={openGraph.locale} />
    <meta property="og:title" content={title} />
    {description !== '' && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={openGraph.imageAlt} />
    <meta name="twitter:card" content={openGraph.twitterCard} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={openGraph.imageAlt} />

    {
      /*
      PLACEHOLDER favicon and manifest. Neither is a brand asset: the icon is a
      plain geometric glyph carrying no wordmark, monogram, or logotype, and the
      manifest names the product using the approved public string only.
      Replace both files, do not edit them in place, when P-15 lifts.
    */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1210" media="(prefers-color-scheme: dark)" />

    {structuredData && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    {
      /*
      Deliberately absent, each with a reason:
        - `logo` in the Organization JSON-LD — brand asset, blocked by P-15.
        - security.txt — needs a real contact and expiry — blocked by Open Item C.
        - humans.txt, feed.xml, rss.xml — see src/lib/deferred-static.ts.
        - A wordmark SVG — a real brand asset, still blocked by P-15.
        - Web fonts — `08` §8 budget is zero, and `07` §3 specifies a system stack.
        - Analytics — blocked by P-06.
        - Any executable script. This build ships zero bytes of client JavaScript;
          the JSON-LD block above is data, not code, and does not execute.
    */
    }
  </head>

  <body>
    <div class="page">
      {
        /*
        `03` Block 0 — first element in DOM inside <body>.
        Text is PROVISIONAL (GAP-01 in copy.ts): `04` specifies no skip-link
        string. Pending founder ratification.
      */
      }
      <a class="skip-link" href="#main">{PROVISIONAL.skipLinkText}</a>

      <SiteHeader currentPath={canonicalPath} />

      <Container as="main" id="main">
        <slot />
      </Container>

      <SiteFooter currentPath={canonicalPath} />
    </div>
  </body>
</html>
