---
import { experience, nav } from '../content/copy';
import Button from './ui/Button.astro';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const primaryItems = ['/platform', '/products', '/trust', '/technology'].map((href) =>
  nav.items.find((item) => item.href === href)!,
);

const iconPaths: Record<string, string[]> = {
  '/platform': ['M4 6.5 12 3l8 3.5-8 3.5-8-3.5Z', 'm4 11 8 3.5 8-3.5', 'm4 15.5 8 3.5 8-3.5'],
  '/products': ['M4 4h6v6H4z', 'M14 4h6v6h-6z', 'M4 14h6v6H4z', 'M14 14h6v6h-6z'],
  '/trust': ['M12 3 19 6v5c0 4.6-2.9 7.7-7 10-4.1-2.3-7-5.4-7-10V6l7-3Z', 'm9 12 2 2 4-4'],
  '/technology': ['M9 3h6v3H9z', 'M8 6h8a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3Z', 'M9 21h6', 'M9 10h6v4H9z'],
};
---

<div class="site-nav">
  <nav class="site-nav__desktop" aria-label={nav.label}>
    <ul class="site-nav__list">
      {
        primaryItems.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={item.href}
              aria-current={item.href === currentPath ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="site-nav__item--cta">
        <Button as="a" href={experience.nav.primaryHref} class="site-nav__cta">
          {experience.nav.primaryAction}
        </Button>
      </li>
    </ul>
  </nav>

  <details class="mobile-menu">
    <summary class="mobile-menu__trigger">
      <span class="mobile-menu__label">Menu</span>
      <svg class="menu-icon menu-icon--open" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="menu-icon menu-icon--close" aria-hidden="true" viewBox="0 0 24 24">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </summary>
    <div class="mobile-menu__panel">
      <nav aria-label="Mobile navigation">
        <p class="mobile-menu__eyebrow">Explore AI Workspace</p>
        <ul class="mobile-menu__list">
          {
            primaryItems.map((item) => (
              <li>
                <a
                  class="mobile-menu__link"
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                >
                  <svg aria-hidden="true" viewBox="0 0 24 24">
                    {iconPaths[item.href].map((path) => <path d={path} />)}
                  </svg>
                  <span>{item.label}</span>
                  <svg class="mobile-menu__arrow" aria-hidden="true" viewBox="0 0 24 24">
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="mobile-menu__cta" href={experience.nav.primaryHref}>
          <span>{experience.nav.primaryAction}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M5 12h14m-6-6 6 6-6 6"></path>
          </svg>
        </a>
      </nav>
    </div>
  </details>
</div>

<style>
  .site-nav__desktop {
    display: none;
  }

  .mobile-menu {
    position: static;
  }

  .mobile-menu__trigger {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-width: 92px;
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu__trigger::-webkit-details-marker {
    display: none;
  }

  .menu-icon,
  .mobile-menu__link svg,
  .mobile-menu__cta svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .menu-icon--close {
    display: none;
  }

  .mobile-menu[open] .menu-icon--open {
    display: none;
  }

  .mobile-menu[open] .menu-icon--close {
    display: block;
  }

  .mobile-menu__panel {
    position: absolute;
    z-index: var(--z-overlay);
    inset-block-start: calc(100% + 1px);
    inset-inline: 0;
    padding: var(--space-4) max(var(--space-5), env(safe-area-inset-right))
      calc(var(--space-5) + env(safe-area-inset-bottom))
      max(var(--space-5), env(safe-area-inset-left));
    border-block-end: 1px solid var(--border-strong);
    background: var(--bg);
    box-shadow: 0 18px 44px rgb(15 23 42 / 0.16);
  }

  .mobile-menu__eyebrow {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mobile-menu__list {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }

  .mobile-menu__link,
  .mobile-menu__cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    min-height: 52px;
    padding: var(--space-3);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link[aria-current='page'] {
    background: var(--bg-subtle);
  }

  .mobile-menu__link[aria-current='page'] {
    font-weight: var(--weight-semibold);
  }

  .mobile-menu__link[aria-current='page']::before {
    position: absolute;
    width: 3px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--accent);
    content: '';
  }

  .mobile-menu__link[aria-current='page'] > svg:first-child {
    color: var(--accent);
  }

  .mobile-menu__arrow {
    width: 18px !important;
    height: 18px !important;
    color: var(--fg-muted);
  }

  .mobile-menu__cta {
    margin-block-start: var(--space-3);
    background: var(--accent);
    color: var(--accent-fg);
    font-weight: var(--weight-semibold);
  }

  .mobile-menu__cta svg {
    grid-column: 3;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    color: var(--fg);
    font-size: var(--type-small);
    text-decoration: none;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    background: var(--bg-subtle);
  }

  .site-nav__link[aria-current='page'] {
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-nav__item--cta {
    margin-inline-start: var(--space-2);
  }

  .site-nav__cta {
    width: auto;
    min-height: 44px;
    padding: 10px 16px;
    font-size: var(--type-small);
  }

  @media (min-width: 960px) {
    .mobile-menu {
      display: none;
    }

    .site-nav__desktop {
      display: block;
    }
  }

  @media (forced-colors: active) {
    .mobile-menu__panel {
      border: 1px solid CanvasText;
    }

    .mobile-menu__link[aria-current='page'] {
      outline: 2px solid Highlight;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu__panel {
      transform-origin: top;
      animation: menu-enter 140ms var(--ease);
    }

    @keyframes menu-enter {
      from {
        transform: translateY(-6px);
        opacity: 0;
      }
    }
  }
</style>
