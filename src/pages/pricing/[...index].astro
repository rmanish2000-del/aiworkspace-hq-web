---
/**
 * `/pricing` — exists ONLY when the founder's numbers are set AND sealed
 * (PRICING-SCAFFOLD, 2026-08-18; Guardian flat-monthly, INR primary + USD
 * secondary per the founder ruling "GUARDIAN · BOTH (INR primary)").
 *
 * Availability line updated 2026-08-21 (BUSINESS-QUEUE B1 live release):
 * private-beta-closed wording removed in the same commit that allows live
 * keys. Words and capability ship together.
 */
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import { sealedPrice } from '../../config/pricing';
import { pricingPage } from '../../content/pricing-page';

export function getStaticPaths() {
  const price = sealedPrice();
  return price.publish ? [{ params: { index: undefined } }] : [];
}

const price = sealedPrice();
if (!price.publish) throw new Error('unreachable: getStaticPaths emitted no path');
const rupees = price.inr.toLocaleString('en-IN');
const dollars = price.usd.toLocaleString('en-US');
---

<Base
  title={pricingPage.metaTitle}
  description={pricingPage.metaDescription}
  canonicalPath="/pricing"
  indexableInProduction={false}
>
  <Container>
    <article class="pricing-page">
      <h1>{pricingPage.heading}</h1>
      <p>
        {pricingPage.priceLeadBefore}<strong>₹{rupees} {pricingPage.perMonth}</strong
        >{pricingPage.gstNote}<span class="pricing-page__usd"
          >({pricingPage.about} ${dollars} {pricingPage.perMonth})</span
        >.
      </p>
      <p class="pricing-page__availability">
        {pricingPage.subscribeAt}{' '}<a href="/checkout">/checkout</a>.{' '}
        {pricingPage.questionsBeforePay}{' '}<a href="mailto:founder@aiworkspacehq.com"
          >founder@aiworkspacehq.com</a
        >{' '}{pricingPage.monitored}
      </p>
      <p class="pricing-page__seal">
        {pricingPage.sealLead} {price.seal.date}.
      </p>
    </article>
  </Container>
</Base>

<style>
  .pricing-page {
    padding-block: var(--space-9);
    max-width: var(--measure-body);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .pricing-page__availability {
    font-weight: var(--weight-semibold);
    margin-block-start: var(--space-2);
    overflow-wrap: anywhere;
  }
  .pricing-page__seal {
    color: var(--fg-muted);
    font-size: var(--type-small);
  }
  .pricing-page__usd {
    overflow-wrap: anywhere;
  }
</style>
