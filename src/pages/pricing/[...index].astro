---
/**
 * `/pricing` — sealed-price only (PRICING-SCAFFOLD). Live availability
 * line from B1 (2026-08-21). Words and capability ship together.
 * Concrete Guardian example (2026-08-26): one before-and-after before pay.
 */
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import { sealedPrice } from '../../config/pricing';
import { pricingPage } from '../../content/pricing-page';

export function getStaticPaths() {
  const price = sealedPrice();
  return price.publish ? [{ params: { index: undefined } }] : [];
}

const price = sealedPrice();
if (!price.publish) throw new Error('unreachable: getStaticPaths emitted no path');
const rupees = price.inr.toLocaleString('en-IN');
const dollars = price.usd.toLocaleString('en-US');
---

<Base
  title={pricingPage.metaTitle}
  description={pricingPage.metaDescription}
  canonicalPath="/pricing"
  indexableInProduction={false}
>
  <Container>
    <article class="pricing-page">
      <h1>{pricingPage.heading}</h1>
      <p>
        {pricingPage.priceLeadBefore}<strong>₹{rupees} {pricingPage.perMonth}</strong>{
          pricingPage.gstNote
        }
        <span class="pricing-page__usd"
          >({pricingPage.about} ${dollars} {pricingPage.perMonth})</span
        >.
      </p>

      <section class="pricing-page__example" aria-labelledby="guardian-example-heading">
        <p class="pricing-page__example-eyebrow">{pricingPage.exampleEyebrow}</p>
        <h2 id="guardian-example-heading">{pricingPage.exampleHeading}</h2>
        <p>{pricingPage.exampleLead}</p>
        <dl class="pricing-page__example-pair">
          <div>
            <dt>{pricingPage.exampleBeforeLabel}</dt>
            <dd><code>{pricingPage.exampleBefore}</code></dd>
          </div>
          <div>
            <dt>{pricingPage.exampleAfterLabel}</dt>
            <dd><code>{pricingPage.exampleAfter}</code></dd>
          </div>
        </dl>
        <p class="pricing-page__example-note">{pricingPage.exampleNote}</p>
      </section>

      <p class="pricing-page__availability">
        {pricingPage.subscribeAt}
        <a href="/checkout">/checkout</a>. {pricingPage.questionsBeforePay}
        <a href="mailto:founder@aiworkspacehq.com">founder@aiworkspacehq.com</a>
        {pricingPage.monitored}
      </p>
      <p class="pricing-page__seal">
        {pricingPage.sealLead}
        {price.seal.date}.
      </p>
    </article>
  </Container>
</Base>

<style>
  .pricing-page {
    padding-block: var(--space-9);
    max-width: var(--measure-body);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .pricing-page__availability {
    font-weight: var(--weight-semibold);
    margin-block-start: var(--space-2);
    overflow-wrap: anywhere;
  }
  .pricing-page__seal {
    color: var(--fg-muted);
    font-size: var(--type-small);
  }
  .pricing-page__usd {
    overflow-wrap: anywhere;
  }
  .pricing-page__example {
    margin-block: var(--space-7);
    padding: var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }
  .pricing-page__example-eyebrow {
    font-size: var(--type-small);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 var(--space-2);
  }
  .pricing-page__example h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--type-h3, 1.25rem);
  }
  .pricing-page__example-pair {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .pricing-page__example-pair dt {
    font-size: var(--type-small);
    color: var(--fg-muted);
    margin: 0 0 var(--space-1);
  }
  .pricing-page__example-pair dd {
    margin: 0;
  }
  .pricing-page__example-pair code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--type-small);
  }
  .pricing-page__example-note {
    margin: 0;
    font-size: var(--type-small);
    color: var(--fg-muted);
  }
</style>
