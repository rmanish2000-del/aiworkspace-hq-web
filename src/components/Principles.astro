---
/**
 * `03` Block 3 — Principles. This block *is* the differentiation section.
 *
 * Structure per `03` §3:
 *   - <h2> "How we are building it"
 *   - the section lead paragraph, immediately below the h2
 *   - a <ul> of five <li>; each <li> contains the principle as an <h3> — NOT a
 *     <strong>, because the document outline in `03` §4 requires five h3
 *     elements — and a one-sentence gloss as body text.
 *
 * Order is fixed and matches the approved foundation. No icons, no numbering,
 * no cards with borders competing for attention (`03` §3, `07` §1).
 *
 * The section is labelled by its own heading so it exposes an accessible name
 * (`03` §2: `<section aria-labelledby>`).
 */
import { principles } from '../content/copy';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import TermList from './ui/TermList.astro';

const HEADING_ID = 'principles-heading';
---

<Section headingId={HEADING_ID}>
  <SectionHeader id={HEADING_ID} heading={principles.heading} lead={principles.lead} />

  {
    /*
    A plain list, not the design system's Grid or Card. `03` §3 rules both out
    for this block by name: "No icons. No numbering. No cards with borders
    competing for attention."

    Level 3 here — these sit under the section's own h2, so the outline reads
    h2 → h3. On `/principles` the same five entries are level 2, because there
    they are the page's top-level content.
  */
  }
  <TermList
    variant="heading"
    level={3}
    items={principles.items.map((principle) => ({ term: principle.title, body: principle.gloss }))}
  />
</Section>
