---
/**
 * Callout — a left-bordered block of set-apart text.
 *
 * Generalises the stage disclosure in `07` §6.4: a 2px `--border-strong` left
 * border, `--space-4` inline padding, `--fg-muted` text.
 *
 * `07` §6.4 is emphatic about the tone: "Not a warning banner, not a yellow
 * box. The tone is factual disclosure, not caution." The `danger` and `success`
 * tones below therefore exist for form states (`07` §6.8, §6.10) and must not
 * be used to dramatise ordinary prose.
 *
 * Provenance: CANONICAL for `tone="neutral"`; the other tones are EXTENSION,
 *   derived from the `--danger` and `--success` tokens `07` §2 already defines.
 * Accessibility:
 *   - a Callout is not an alert. It renders a plain block with no ARIA role, so
 *     it does not interrupt a screen reader. `07` §6.9 reserves `role="alert"`
 *     for the error summary, which is a different component.
 *   - `07` §2: colour is never the sole carrier of meaning, so a non-neutral
 *     tone must also carry text saying what it means. The component cannot
 *     enforce that — the usage rules do.
 *   - `min-height` rather than a fixed height, so text-spacing overrides
 *     (WCAG 1.4.12) cannot clip it.
 * JavaScript: none.
 */
export interface Props {
  /** `neutral` is the `07` §6.4 stage-disclosure treatment. */
  tone?: 'neutral' | 'danger' | 'success';
  as?: 'p' | 'div' | 'aside';
  class?: string;
}

const { tone = 'neutral', as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['callout', `callout--${tone}`, className]}>
  <slot />
</Tag>

<style>
  .callout {
    border-inline-start: 2px solid var(--border-strong);
    padding-inline: var(--space-4);
    font-size: var(--type-stage);
    font-weight: var(--weight-medium);
    line-height: var(--leading-stage);
    color: var(--fg-muted);
    /* WCAG 1.4.12 — never a fixed height. */
    min-height: var(--space-6);
  }

  .callout--danger {
    border-inline-start-color: var(--danger);
    color: var(--danger);
  }

  .callout--success {
    border-inline-start-color: var(--success);
    color: var(--fg);
  }
</style>
